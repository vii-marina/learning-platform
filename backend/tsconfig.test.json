{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  // src/types/express.d.ts carries the `req.auth` augmentation. Without it here, any test that
  // imports a module touching req.auth (e.g. middleware/auth) fails to typecheck even though the
  // production tsconfig is clean.
  "include": ["tests/**/*.ts", "vitest.config.ts", "src/types/express.d.ts"]
}
